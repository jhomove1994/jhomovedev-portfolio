---
import type { Locale } from '../../i18n/locales';
import { buildHeadMeta } from '../../lib/seo/alternates';
import { OG_IMAGE_HEIGHT, OG_IMAGE_WIDTH, ogImageAlt, ogImageType } from '../../lib/seo/og-image';
import { buildPersonJsonLd, serializeJsonLd, type PersonInput } from '../../lib/seo/person';

interface Props {
  locale: Locale;
  /** Current pathname, with or without the locale prefix. */
  path: string;
  title: string;
  description?: string | undefined;
  /** Public path or absolute URL; the og:image tags are omitted when unset. */
  ogImage?: string | undefined;
  /** Profile content for the Person JSON-LD and the og:image alt text; both are omitted when unset. */
  profile?: Omit<PersonInput, 'url' | 'image' | 'description'> | undefined;
  /** Utility pages (404) are not indexable and carry no canonical or alternates. */
  noindex?: boolean;
}

const { locale, path, title, description, ogImage, profile, noindex = false } = Astro.props;
const meta = noindex ? undefined : buildHeadMeta({ site: Astro.site?.href, locale, path, ogImage });
const imageType = meta?.ogImage ? ogImageType(meta.ogImage) : undefined;
const personJsonLd =
  meta && profile
    ? serializeJsonLd(
        buildPersonJsonLd({
          ...profile,
          description: description ?? '',
          url: meta.canonical,
          image: meta.ogImage,
        }),
      )
    : undefined;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<title>{title}</title>
{description && <meta name="description" content={description} />}
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
{noindex && <meta name="robots" content="noindex" />}
{meta && (
  <>
    <link rel="canonical" href={meta.canonical} />
    {meta.alternates.map(({ hreflang, href }) => (
      <link rel="alternate" hreflang={hreflang} href={href} />
    ))}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={meta.canonical} />
    <meta property="og:locale" content={meta.ogLocale} />
    {meta.ogLocaleAlternates.map((alternate) => (
      <meta property="og:locale:alternate" content={alternate} />
    ))}
    {meta.ogImage && <meta property="og:image" content={meta.ogImage} />}
    {meta.ogImage && <meta property="og:image:width" content={String(OG_IMAGE_WIDTH)} />}
    {meta.ogImage && <meta property="og:image:height" content={String(OG_IMAGE_HEIGHT)} />}
    {meta.ogImage && imageType && <meta property="og:image:type" content={imageType} />}
    {meta.ogImage && profile && (
      <meta property="og:image:alt" content={ogImageAlt(profile.name, profile.headline)} />
    )}
    <meta name="twitter:card" content={meta.ogImage ? 'summary_large_image' : 'summary'} />
  </>
)}
{personJsonLd && <script type="application/ld+json" set:html={personJsonLd} />}
