---
import type { Locale } from '../../i18n/locales';
import SectionHead from '../layout/SectionHead.astro';
import { formatDate } from '../../lib/content/period';
import { shortHash } from '../../lib/motion/commit-hash';
import { currentStage } from '../../lib/motion/stage';
import { t } from '../../i18n/ui';
import DevFallbackBadge from '../ui/DevFallbackBadge.astro';

export interface Milestone {
  /** Content slug; only seeds the decorative short hash of the commit line. */
  slug: string;
  title: string;
  evidence: string;
  date?: string | undefined;
  link?: string | undefined;
  isFallback: boolean;
  /** Development only: the entry still carries a TODO(autor) placeholder. */
  marked: boolean;
}

interface Props {
  locale: Locale;
  /** Already ordered and filtered by the page (G1); the block is omitted when empty. */
  milestones: Milestone[];
}

const { locale, milestones } = Astro.props;
const current = currentStage(milestones.map(({ marked }) => marked));
---

{milestones.length > 0 && (
  <section
    id="path"
    aria-labelledby="path-title"
    data-reveal
    class="scroll-mt-20 border-t border-border py-12 lg:grid lg:grid-cols-[15rem_1fr] lg:gap-x-12 lg:py-16"
  >
    <SectionHead
      locale={locale}
      id="path-title"
      titleKey="nav.pathToTechLead"
      commandKey="sectionCommands.path"
    />
    <div data-path class="relative">
      <svg
        aria-hidden="true"
        class="path-line"
        viewBox="0 0 2 100"
        preserveAspectRatio="none"
        focusable="false"
      >
        <path class="path-base" d="M1 0V100" pathLength="1"></path>
        <path data-path-line class="path-trace" d="M1 0V100" pathLength="1"></path>
      </svg>
      <ol>
        {milestones.map(({ slug, title, evidence, date, link, isFallback, marked }, index) => (
          <li data-row class="relative pb-10 pl-9 last:pb-0">
            <span
              data-commit-node
              data-path-node={marked ? undefined : ''}
              data-current={index === current ? '' : undefined}
              aria-hidden="true"
              class:list={[
                'absolute top-[0.45rem] left-0 size-[11px] rounded-full',
                marked ? 'border border-dashed border-warn' : 'bg-accent',
              ]}
            />
            <div class:list={[marked && 'border border-dashed border-warn p-3']}>
              <DevFallbackBadge locale={locale} isFallback={isFallback} />
              <p data-commit-head class="commit-head">
                <span data-type class="commit-hash">
                  {shortHash(slug)}
                </span>
                {index === current && (
                  <span data-type class="commit-ref">
                    {t(locale, 'gitLog.headRef')}
                  </span>
                )}
                {date && (
                  <span data-type class="commit-date">
                    {formatDate(date, locale)}
                  </span>
                )}
              </p>
              <div data-row-body>
                <h3 class="text-lg">
                  {link ? (
                    <a href={link} rel="noopener" class="underline">
                      {title}
                    </a>
                  ) : (
                    title
                  )}
                </h3>
                <p class="mt-2">{evidence}</p>
              </div>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>
)}
