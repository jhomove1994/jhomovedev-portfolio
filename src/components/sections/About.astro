---
import type { Locale } from '../../i18n/locales';
import SectionHead from '../layout/SectionHead.astro';
import DevFallbackBadge from '../ui/DevFallbackBadge.astro';

interface Props {
  locale: Locale;
  bio: string;
  isFallback?: boolean;
}

const { locale, bio, isFallback = false } = Astro.props;
---

<section
  id="about"
  aria-labelledby="about-title"
  data-reveal
  class="scroll-mt-20 border-t border-border py-12 lg:grid lg:grid-cols-[15rem_1fr] lg:gap-x-12 lg:py-16"
>
  <SectionHead
    locale={locale}
    id="about-title"
    titleKey="nav.about"
    commandKey="sectionCommands.about"
  />
  <div data-reveal-item>
    <DevFallbackBadge locale={locale} isFallback={isFallback} />
    <p>{bio}</p>
  </div>
</section>
