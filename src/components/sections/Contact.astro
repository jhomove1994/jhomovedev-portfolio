---
import type { Locale } from '../../i18n/locales';
import { t } from '../../i18n/ui';
import { displayUrl } from '../../lib/content/display-url';
import SectionHead from '../layout/SectionHead.astro';
import CopyEmailButton from '../ui/CopyEmailButton.astro';

interface Props {
  locale: Locale;
  email: string;
  linkedin: string;
  /** Only rendered when the author fills it in; it is empty in the seed. */
  whatsapp?: string | undefined;
}

const { locale, email, linkedin, whatsapp } = Astro.props;
---

<section
  id="contact"
  aria-labelledby="contact-title"
  data-reveal
  class="scroll-mt-20 border-t border-border py-12 lg:grid lg:grid-cols-[15rem_1fr] lg:gap-x-12 lg:py-16"
>
  <SectionHead
    locale={locale}
    id="contact-title"
    titleKey="nav.contact"
    commandKey="sectionCommands.contact"
  />
  <ul class="space-y-4">
    <li data-reveal-item class="flex flex-wrap items-center gap-x-4 gap-y-2">
      <span class="text-muted">{t(locale, 'labels.email')}</span>
      <a href={`mailto:${email}`} class="underline">
        {email}
      </a>
      <CopyEmailButton locale={locale} email={email} />
    </li>
    <li data-reveal-item>
      <a href={linkedin} rel="noopener noreferrer" class="underline">
        {displayUrl(linkedin)}
      </a>
    </li>
    {whatsapp && (
      <li data-reveal-item>
        <a href={whatsapp} rel="noopener noreferrer" class="underline">
          {displayUrl(whatsapp)}
        </a>
      </li>
    )}
  </ul>
</section>
