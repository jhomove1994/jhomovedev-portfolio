---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header, { type NavItem } from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import SectionMotion from '../../components/motion/SectionMotion.astro';
import Hero from '../../components/sections/Hero.astro';
import About from '../../components/sections/About.astro';
import TechLeadPath, { type Milestone } from '../../components/sections/TechLeadPath.astro';
import Contact from '../../components/sections/Contact.astro';
import Experience, { type Role } from '../../components/sections/Experience.astro';
import Certifications, {
  type Credential,
  type CredentialGroup,
} from '../../components/sections/Certifications.astro';
import { LOCALES, DEFAULT_LOCALE, type Locale } from '../../i18n/locales';
import {
  getCertifications,
  getExperience,
  getLeadership,
  getMedia,
  getProfile,
  getProjects,
  getStack,
} from '../../lib/content/queries';
import { cvButton } from '../../lib/content/cv';
import { parseEntryId } from '../../lib/content/entry-id';
import { groupByKind } from '../../lib/content/group';
import { parseBulletList } from '../../lib/content/markdown-list';
import { formatPeriod } from '../../lib/content/period';
import { CERTIFICATION_KINDS } from '../../lib/content/schemas';
import { resolveStackNames } from '../../lib/content/stack-names';
import { t } from '../../i18n/ui';
import { withTodoVisibility } from '../../lib/content/todo';
import { buildTerminalData } from '../../lib/terminal/data';

export const getStaticPaths = (() =>
  LOCALES.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const locale = Astro.params.lang as Locale;
const localizedProfile = await getProfile(locale);
const profile = localizedProfile.entry.data;
// The share image falls back to the default locale when this locale has none.
// Only a locale's own media file counts: a fallback copy would hide that its CV is Spanish.
const ownMedia = async (mediaLocale: Locale) => {
  const media = await getMedia(mediaLocale);
  return media && !media.isFallback ? media.entry.data : undefined;
};
const mediaByLocale = { es: await ownMedia('es'), en: await ownMedia('en') };
const ogImage =
  (await getMedia(locale))?.entry.data.ogImage ??
  (await getMedia(DEFAULT_LOCALE))?.entry.data.ogImage;

const asText = (value: unknown) => (typeof value === 'string' ? value : undefined);

// G1 default: TODO(autor) milestones are hidden in production and dashed-marked in development.
const milestones: Milestone[] = withTodoVisibility(
  await getLeadership(locale),
  ({ entry }) => [entry.data.title, entry.data.evidence],
  import.meta.env.DEV,
).map(({ item, marked }) => ({
  slug: parseEntryId(item.entry.id).slug,
  title: item.entry.data.title,
  evidence: item.entry.data.evidence,
  // optionalText() types its output as unknown (the preprocess step); narrow it here.
  date: asText(item.entry.data.date),
  link: asText(item.entry.data.link),
  isFallback: item.isFallback,
  marked,
}));

const stackCatalog = await getStack();
const experience = await getExperience(locale);
const roles: Role[] = experience.map(({ entry, isFallback }) => ({
  role: entry.data.role,
  company: entry.data.company,
  location: entry.data.location,
  period: formatPeriod(entry.data.start, entry.data.end, locale, t(locale, 'labels.present')),
  achievements: parseBulletList(entry.data.achievements),
  stack: resolveStackNames(entry.data.stack, stackCatalog),
  isFallback,
}));

const certifications = await getCertifications(locale);
const credentialGroups: CredentialGroup[] = groupByKind(
  certifications.map(({ entry, isFallback }) => ({
    kind: entry.data.kind,
    credential: {
      name: entry.data.name,
      code: asText(entry.data.code),
      issuer: entry.data.issuer,
      year: entry.data.year,
      inProgress: entry.data.status === 'in-progress',
      credentialUrl: asText(entry.data.credentialUrl),
      isFallback,
    } satisfies Credential,
  })),
  CERTIFICATION_KINDS,
).map(({ kind, items }) => ({ kind, items: items.map(({ credential }) => credential) }));

// G1 applies to the terminal too: placeholders are hidden in production and visible in development.
const projects = await getProjects(locale);
const terminal = buildTerminalData({
  locale,
  isDev: import.meta.env.DEV,
  profile,
  experience: experience.map(({ entry }) => entry),
  projects: projects.map(({ entry }) => ({ slug: parseEntryId(entry.id).slug, data: entry.data })),
  stackCatalog: stackCatalog,
  certifications: certifications.map(({ entry }) => entry),
  media: { es: mediaByLocale.es, en: mediaByLocale.en },
});

const navItems: NavItem[] = [
  { id: 'about', labelKey: 'nav.about' },
  ...(milestones.length > 0 ? [{ id: 'path', labelKey: 'nav.pathToTechLead' } as const] : []),
  ...(roles.length > 0 ? [{ id: 'experience', labelKey: 'nav.experience' } as const] : []),
  ...(credentialGroups.length > 0
    ? [{ id: 'certifications', labelKey: 'nav.certifications' } as const]
    : []),
  { id: 'contact', labelKey: 'nav.contact' },
];
---

<BaseLayout
  locale={locale}
  title={profile.seo.title}
  description={profile.seo.description}
  ogImage={ogImage}
>
  <Header slot="header" locale={locale} brand={profile.brand} items={navItems} />
  <main id="main" class="w-full">
    <Hero
      locale={locale}
      name={profile.name}
      headline={profile.headline}
      location={profile.location}
      remote={profile.remote}
      email={profile.contact.email}
      cv={cvButton(mediaByLocale, locale)}
      terminal={terminal}
    />
    <div class="mx-auto w-full max-w-5xl px-5 pt-10 lg:px-8 lg:pt-16">
      <About locale={locale} bio={profile.bio} isFallback={localizedProfile.isFallback} />
      <TechLeadPath locale={locale} milestones={milestones} />
      <Experience locale={locale} roles={roles} />
      <Certifications locale={locale} groups={credentialGroups} />
      <Contact
        locale={locale}
        email={profile.contact.email}
        linkedin={profile.contact.linkedin}
        whatsapp={asText(profile.contact.whatsapp)}
      />
    </div>
    <SectionMotion />
  </main>
  <Footer slot="footer" name={profile.name} />
</BaseLayout>
