---
import '../styles/global.css';
import Head from '../components/seo/Head.astro';
import { t } from '../i18n/ui';
import type { Locale } from '../i18n/locales';

interface Props {
  locale: Locale;
  title: string;
  description?: string | undefined;
  ogImage?: string | undefined;
  noindex?: boolean;
}

const { locale, title, description, ogImage, noindex } = Astro.props;
---

<html lang={locale}>
  <head>
    <Head
      locale={locale}
      path={Astro.url.pathname}
      title={title}
      description={description}
      ogImage={ogImage}
      noindex={noindex}
    />
    <slot name="head" />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:bg-surface focus:px-3 focus:py-2"
    >
      {t(locale, 'aria.skipToContent')}
    </a>
    <slot name="header" />
    <slot />
    <slot name="footer" />
  </body>
</html>
