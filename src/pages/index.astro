---
import { DEFAULT_LOCALE, LOCALES } from '../i18n/locales';
import { pickLocale } from '../lib/i18n/accept-language';
import { localizedPath } from '../lib/i18n/paths';

// The only on-demand route: it negotiates the language once and every other page stays static.
export const prerender = false;

const locale = pickLocale(Astro.request.headers.get('accept-language'), LOCALES, DEFAULT_LOCALE);

// The target comes from the locale allowlist only, never from request input.
return new Response(null, {
  status: 302,
  headers: {
    Location: localizedPath(locale),
    Vary: 'Accept-Language',
    'Cache-Control': 'private, no-store',
  },
});
---
