---
import type { Locale } from '../../i18n/locales';
import { t, terminalLabels } from '../../i18n/ui';
import type { CvButtonModel } from '../../lib/content/cv';
import stillAnchor from '../../lib/hero/still-anchor.json';
import { narrowStillLayout } from '../../lib/hero/still-layout';
import { shippableLabels } from '../../lib/terminal/labels';
import type { TerminalData } from '../../lib/terminal/types';
import { HeroIsland } from '../hero/HeroIsland';
import HeroStill from '../hero/HeroStill.astro';
import CvButton from '../ui/CvButton.astro';

interface Props {
  locale: Locale;
  name: string;
  headline: string;
  location: string;
  remote: boolean;
  email: string;
  /** `null` until a CV is uploaded; the button is then omitted. */
  cv: CvButtonModel | null;
  /** Content the terminal prints, already filtered for the current environment. */
  terminal: TerminalData;
}

// Availability is deliberately not a prop: it is not rendered until the author confirms the value.
const { locale, name, headline, location, remote, email, cv, terminal } = Astro.props;

const labels = shippableLabels(terminalLabels(locale), terminal);
const chrome = {
  enable3d: t(locale, 'hero.toggleEnable3d'),
  disable3d: t(locale, 'hero.toggleDisable3d'),
  bootLoading: t(locale, 'hero.bootLoading'),
};
// The glass rect of the committed still. Wide screens place the terminal on it as fractions of the
// stage; stacked screens crop the still around it (`--n-*`, in `cqw` of the stage width).
const narrow = narrowStillLayout(stillAnchor);
const cqw = (fraction: number) => `${(fraction * 100).toFixed(3)}cqw`;
const stageStyle = [
  `--mon-x:${stillAnchor.x * 100}%`,
  `--mon-y:${stillAnchor.y * 100}%`,
  `--mon-w:${stillAnchor.width * 100}%`,
  `--mon-h:${stillAnchor.height * 100}%`,
  `--n-media-w:${cqw(narrow.mediaWidth)}`,
  `--n-media-x:${cqw(narrow.mediaLeft)}`,
  `--n-media-y:${cqw(narrow.mediaTop)}`,
  `--n-box-h:${cqw(narrow.boxHeight)}`,
  `--n-glass-x:${cqw(narrow.glassLeft)}`,
  `--n-glass-y:${cqw(narrow.glassTop)}`,
  `--n-glass-w:${cqw(narrow.glassWidth)}`,
  `--n-glass-h:${cqw(narrow.glassHeight)}`,
].join(';');
---

<section id="hero" aria-labelledby="hero-title" data-hero-mode="static" class="hero">
  <div class="hero-stage" style={stageStyle}>
    <div class="hero-copy">
      <h1 id="hero-title" class="text-balance">
        {name}
      </h1>
      <p class="hero-headline mt-5 max-w-[32ch] font-display leading-snug">{headline}</p>
      <p class="hero-place mt-6 flex flex-wrap gap-x-6 gap-y-1 text-muted">
        <span>{location}</span>
        {remote && <span>{t(locale, 'labels.remote')}</span>}
      </p>
      <p class="hero-cta mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
        <CvButton button={cv} />
        <a href={`mailto:${email}`} class="inline-flex min-h-11 items-center underline">
          {t(locale, 'buttons.sendEmail')}
        </a>
      </p>
    </div>
    <HeroStill locale={locale} />
    <div class="hero-monitor">
      <HeroIsland client:visible data={terminal} labels={labels} chrome={chrome} />
    </div>
  </div>
</section>
